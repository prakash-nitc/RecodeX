{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "esModuleInterop": true,
    "isolatedModules": true,
    "noImplicitAny": false
  },
  "include": ["src", "supabase", "e2e", "vite.config.ts", "playwright.config.ts"]
}
