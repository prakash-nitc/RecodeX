# Copy to .env and fill in from Supabase → Project Settings → API Keys.
# Without these the app runs on localStorage with no sign-in.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (sb_publishable_…) or legacy anon key. Never put the secret / service_role key here.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
